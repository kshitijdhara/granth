{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "tsc --noEmit && bun run scripts/build.ts",
		"preview": "bun run scripts/preview.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint ./src",
		"format": "biome format ./src",
		"check": "biome check ./src",
		"check:write": "biome check --write ./src"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router-dom": "^7.15.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"sass": "^1.100.0",
		"typescript": "~5.9.3"
	}
}
